<Window x:Class="Involucrate.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Login" 
        Height="300" 
        Width="400"
        WindowStyle="None" 
        AllowsTransparency="True" 
        Background="White">
    <Grid>
        <Border Background="#ff66c4" Height="30" VerticalAlignment="Top">
            <Grid>
                <TextBlock Text="Login" Foreground="White" VerticalAlignment="Center" Margin="10,0,0,0"/>
                <Button Content="X" Background="Transparent" Foreground="White" HorizontalAlignment="Right" VerticalAlignment="Center" Width="30" Height="30" Click="CloseButton_Click"/>
            </Grid>
        </Border>
        <Label Content="Correo Electrónico:" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="30,80,0,0"/>
        <TextBox Name="txtEmail" HorizontalAlignment="Left" Height="23" Margin="150,80,0,0" VerticalAlignment="Top" Width="200"/>
        <Label Content="Contraseña:" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="30,130,0,0"/>
        <PasswordBox Name="txtPassword" HorizontalAlignment="Left" Height="23" Margin="150,130,0,0" VerticalAlignment="Top" Width="200"/>
        <Button Content="Login" HorizontalAlignment="Left" VerticalAlignment="Top" Width="81" Margin="150,180,0,0" Background="#ff66c4" Foreground="White" Click="BtnLogin_Click" Height="27"/>
        <Button Content="Registro" HorizontalAlignment="Left" VerticalAlignment="Top" Width="89" Margin="250,180,0,0" Background="#ff66c4" Foreground="White" Click="BtnRegister_Click" Height="27"/>
    </Grid>
</Window>
