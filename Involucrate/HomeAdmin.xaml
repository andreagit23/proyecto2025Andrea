<Window x:Class="Involucrate.HomeAdmin"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Involucrate"
        mc:Ignorable="d"
        Title="Gestión administrativa" Height="450" Width="800">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition  Width="250" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <StackPanel Grid.Column="0" Background="#FFB6C1" Margin="20" VerticalAlignment="Stretch">
            <TextBlock Text="INVOLÚCRATE" FontSize="24" FontWeight="Bold" Foreground="White" Margin="0,0,0,40" />
            <Button Content="Incidencias" Background="#FFFFFF" Style="{StaticResource NavButtonStyle}" Margin="10,10,9.6,10" />
            <Button Content="Transacciones" Background="#FFFFFF" Style="{StaticResource NavButtonStyle}" Margin="10,10,9.6,10" />
            <Button Content="Validar ONGs" Background="#FFFFFF" Style="{StaticResource NavButtonStyle}" Margin="10,10,0,10" HorizontalAlignment="Left" Width="190" />
            <Button Content="Notificaciones" Background="#FFFFFF" Style="{StaticResource NavButtonStyle}" Margin="10,10,9.6,10" />
        </StackPanel>

        <!-- Main Panel -->
        <Grid Grid.Column="1" Margin="20">
            <TabControl>
                <!-- Incidencias -->
                <TabItem Header="Incidencias">
                    <DataGrid x:Name="dgIncidencias" AutoGenerateColumns="False" Margin="10">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50" />
                            <DataGridTextColumn Header="Usuario" Binding="{Binding Usuario}" Width="150" />
                            <DataGridTextColumn Header="Contenido" Binding="{Binding Contenido}" Width="*" />
                            <DataGridCheckBoxColumn Header="Leída" Binding="{Binding Leida}" Width="70" />
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>

                <!-- Transacciones -->
                <TabItem Header="Transacciones">
                    <DataGrid x:Name="dgTransacciones" AutoGenerateColumns="False" Margin="10">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50" />
                            <DataGridTextColumn Header="Usuario" Binding="{Binding Usuario}" Width="150" />
                            <DataGridTextColumn Header="Cantidad" Binding="{Binding Cantidad}" Width="100" />
                            <DataGridTextColumn Header="Tipo" Binding="{Binding Tipo}" Width="100" />
                            <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha}" Width="150" />
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>

                <!-- Validar ONGs -->
                <TabItem Header="Validar ONGs">
                    <DataGrid x:Name="dgONGs" AutoGenerateColumns="False" Margin="10">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50" />
                            <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="200" />
                            <DataGridTextColumn Header="Correo" Binding="{Binding Correo}" Width="200" />
                            <DataGridTextColumn Header="Verificada" Binding="{Binding Verificada}" Width="100" />
                            <DataGridTemplateColumn Header="Acción" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Validar" Background="LightGreen" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>

                <!-- Notificaciones -->
                <TabItem Header="Notificaciones">
                    <StackPanel Margin="10">
                        <TextBlock Text="Título" />
                        <TextBox x:Name="txtTitulo" Margin="0,0,0,10" />

                        <TextBlock Text="Mensaje" />
                        <TextBox x:Name="txtMensaje" AcceptsReturn="True" Height="100" />

                        <TextBlock Text="Destinatarios" Margin="0,10,0,5" />
                        <ComboBox x:Name="cmbUsuarios" Margin="10,0,331.4,0">
                            <ComboBoxItem Content="Todos" IsSelected="True" />
                        </ComboBox>
                        <Button Content="Enviar Notificación" Width="142" Background="#FF69B4" Foreground="White" HorizontalAlignment="Left" Margin="306,10,0,10" Height="27" />
                    </StackPanel>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</Window>
