<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="@android:color/white">

    <!-- Perfil y saludo -->
    <LinearLayout
        android:id="@+id/profileHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp"
        tools:ignore="UseCompoundDrawables">

        <ImageView
            android:id="@+id/iconProfile"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_user"
            android:contentDescription="@string/perfil"
            android:layout_marginEnd="8dp"
            android:radius="24dp"
            android:padding="8dp" />

        <TextView
            android:id="@+id/textSaludo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/saludo"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Card con el menú -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardMenu"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="8dp"
        app:layout_constraintTop_toBottomOf="@id/profileHeader"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:gravity="center_horizontal">

            <Button
                android:id="@+id/btnComprar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/comprar"
                android:textColor="@android:color/white"
                android:backgroundTint="#FF69B4"
                android:drawableLeft="@drawable/ic_comprar"
                android:drawablePadding="8dp"
                android:layout_marginTop="8dp"
                android:radius="24dp"
                tools:ignore="RtlHardcoded" />

            <Button
                android:id="@+id/btnVender"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/vender"
                android:textColor="@android:color/white"
                android:backgroundTint="#FF69B4"
                android:drawableLeft="@drawable/ic_vender"
                android:drawablePadding="8dp"
                android:layout_marginTop="8dp"
                android:radius="24dp"
                tools:ignore="RtlHardcoded" />

            <Button
                android:id="@+id/btnPedidos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/mis_pedidos"
                android:textColor="@android:color/white"
                android:backgroundTint="#FF69B4"
                android:drawableLeft="@drawable/ic_pedidos"
                android:drawablePadding="8dp"
                android:layout_marginTop="8dp"
                android:radius="24dp"
                tools:ignore="RtlHardcoded" />

            <Button
                android:id="@+id/btnMonedero"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/monedero"
                android:textColor="@android:color/white"
                android:backgroundTint="#FF69B4"
                android:drawableLeft="@drawable/ic_monedero"
                android:drawablePadding="8dp"
                android:layout_marginTop="8dp"
                android:radius="24dp"
                tools:ignore="RtlHardcoded" />

            <Button
                android:id="@+id/btnOngs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:backgroundTint="#FF69B4"
                android:drawableLeft="@drawable/ic_ongs"
                android:drawablePadding="4dp"
                android:radius="24dp"
                android:text="@string/ongs"
                android:textColor="@android:color/white"
                tools:ignore="RtlHardcoded" />

            <Button
                android:id="@+id/btnNuestraInformacion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:backgroundTint="#FF69B4"
                android:drawableLeft="@drawable/ic_ongs"
                android:drawablePadding="4dp"
                android:radius="24dp"
                android:text="@string/nuestra_informacion"
                android:textColor="@android:color/white"
                tools:ignore="RtlHardcoded" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>
